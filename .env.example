SPECTRE_APP_NAME=SPECTRE
SPECTRE_ENVIRONMENT=local
SPECTRE_BIND_HOST=127.0.0.1
SPECTRE_BIND_PORT=8000
SPECTRE_SECURE_COOKIES=false
SPECTRE_OUTPUT_DIR=output
SPECTRE_LOG_LEVEL=INFO
SPECTRE_MYSQL_HOST=127.0.0.1
SPECTRE_MYSQL_PORT=3306
SPECTRE_MYSQL_DATABASE=spectre
SPECTRE_MYSQL_USER=spectre
# Replace locally; no default database password is supplied.
SPECTRE_MYSQL_PASSWORD=CHANGE_ME
SPECTRE_SESSION_HOURS=8
SPECTRE_COLLECTOR_TIMEOUT_SECONDS=10
SPECTRE_COLLECTOR_RETRIES=1
SPECTRE_COLLECTOR_MAX_RESPONSE_BYTES=1048576
SPECTRE_COLLECTOR_HOST_INTERVAL_SECONDS=1
SPECTRE_COLLECTOR_MAX_REDIRECTS=3
SPECTRE_DNS_ENABLED=true
SPECTRE_RDAP_ENABLED=true
SPECTRE_CT_ENABLED=true
SPECTRE_REVERSE_DNS_ENABLED=true
SPECTRE_IP_RDAP_ENABLED=true
SPECTRE_IP_ASN_ENABLED=true
SPECTRE_WEB_METADATA_ENABLED=true
SPECTRE_AI_ENABLED=false
# Set an already installed local Ollama model name to opt in. No cloud models.
SPECTRE_AI_MODEL=
SPECTRE_AI_TIMEOUT_SECONDS=30
# Optional explicit active verification; scope + recorded grant + confirmation still required.
SPECTRE_ACTIVE_ASSESSMENT_ENABLED=false
